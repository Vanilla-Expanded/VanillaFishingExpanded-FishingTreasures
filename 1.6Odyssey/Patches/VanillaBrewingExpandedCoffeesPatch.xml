<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Brewing Expanded - Coffees and Teas</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingSetMakerDef[@Name="RareFishingCatchesBase"]/root/options</xpath>
					<value>
						<li>
							<weight>0.1</weight>
							<thingSetMaker Class="ThingSetMaker_StackCount">
								<fixedParams>
									<filter>
										<thingDefs>
											<li>VBE_BlackTea</li>
											<li>VBE_IrishCoffee</li>
											<li>VBE_Kombucha</li>
											<li>VBE_LatteCoffee</li>
											<li>VBE_MochaCoffee</li>
											<li>VBE_PumpkinCoffee</li>
											<li>VBE_Yuenyeung</li>
										</thingDefs>
									</filter>
									<countRange>2~4</countRange>
								</fixedParams>
							</thingSetMaker>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>

