<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Apparel Expanded — Accessories</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingSetMakerDef[@Name="RareFishingCatchesBase"]/root/options</xpath>
					<value>
					
					<li>
							<weight>0.5</weight>
							<thingSetMaker Class="ThingSetMaker_Count">
								<fixedParams>
									<qualityGenerator>Reward</qualityGenerator>
									<filter>
										<thingDefs>
											<li>VAEA_Apparel_Backpack</li>
											<li>VAEA_Apparel_MedicBag</li>
											<li>VAEA_Apparel_Quiver</li>
											<li>VAEA_Apparel_ToolBelt</li>
											<li>VAEA_Apparel_AmmoPack</li>
											<li>VAEA_Apparel_RangedShieldBelt</li>
											
										</thingDefs>
									</filter>
								</fixedParams>
							</thingSetMaker>
						</li>
						
						
						
						
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>

