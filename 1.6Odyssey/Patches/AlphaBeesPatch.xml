<?xml version="1.0" encoding="utf-8" ?>
<Patch>


	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Alpha Bees</li>
		</mods>

		<match Class="PatchOperationSequence">
			<operations>


				<li Class="PatchOperationAdd"> 
					<xpath>/Defs/ThingSetMakerDef[@Name="RareFishingCatchesBase"]/root/options</xpath>
					<value>
						<li>
							<weight>0.75</weight>
							<thingSetMaker Class="ThingSetMaker_StackCount">
								<fixedParams>
									<filter>
										<thingDefs>
											<li>RB_BaseHoney</li>
											<li>RB_Beeswax</li>
											<li>RB_Mead</li>
										</thingDefs>
									</filter>
									<countRange>15~20</countRange>
								</fixedParams>
							</thingSetMaker>
						</li>
						
						<li>
							<weight>0.1</weight>
							<thingSetMaker Class="ThingSetMaker_Count">
								<fixedParams>
									
									<filter>
										<thingDefs>
											<li>RB_ComponentBioInterface</li>
										</thingDefs>
									</filter>
								</fixedParams>
							</thingSetMaker>
						</li>
						
						


					</value>
				</li>


			</operations>
		</match>
	</Operation>


</Patch>

