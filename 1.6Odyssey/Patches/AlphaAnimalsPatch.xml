<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Alpha Animals</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingSetMakerDef[@Name="RareFishingCatchesBase"]/root/options</xpath>
					<value>
						<li>
							<weight>0.05</weight>
							<thingSetMaker Class="ThingSetMaker_Count">
								<fixedParams>
									
									<filter>
										<thingDefs>
											<li>AA_GallatrossHorn</li>
										</thingDefs>
									</filter>
								</fixedParams>
							</thingSetMaker>
						</li>
						<li>
							<weight>0.1</weight>
							<thingSetMaker Class="ThingSetMaker_StackCount">
								<fixedParams>
									<filter>
										<thingDefs>
											<li>AA_BlackInsectJelly</li>
											<li>AA_UraniumCrystals</li>
										</thingDefs>
									</filter>
									<countRange>40~60</countRange>
								</fixedParams>
							</thingSetMaker>
						</li>
						<li>
							<weight>0.1</weight>
							<thingSetMaker Class="ThingSetMaker_StackCount">
								<fixedParams>
									<filter>
										<thingDefs>
											<li>AA_SkySteel</li>
											<li>GU_RedWood</li>
											<li>AA_BlueGel</li>
										</thingDefs>
									</filter>
									<countRange>15~20</countRange>
								</fixedParams>
							</thingSetMaker>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>

