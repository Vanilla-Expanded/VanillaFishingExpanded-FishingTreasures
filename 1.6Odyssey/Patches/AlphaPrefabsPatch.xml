<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Alpha Prefabs</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingSetMakerDef[@Name="RareFishingCatchesBase"]/root/options</xpath>
					<value>
						
						<li>
							<weight>0.1</weight>
							<thingSetMaker Class="ThingSetMaker_Count">
								<fixedParams>
									<filter>
										<thingDefs>
											<li>AP_Prefab_LowValue</li>
											<li>AP_Prefab</li>
											<li>AP_Prefab_MediumHighValue</li>
											
										</thingDefs>
									</filter>
								</fixedParams>
							</thingSetMaker>
						</li>
						<li>
							<weight>0.05</weight>
							<thingSetMaker Class="ThingSetMaker_Count">
								<fixedParams>
									<filter>
										<thingDefs>
											<li>AP_Prefab_HighValue</li>
											
										</thingDefs>
									</filter>
								</fixedParams>
							</thingSetMaker>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>

